---
import CheckoutBridgeLayout from '../../../layouts/CheckoutBridgeLayout.astro';
import {
  ZADEYO_TARKOV_CHECKOUT_URL,
  ZADEYO_R6_PRODUCT_SEO,
} from '../../../config/zadeyoTarkovProductSeo';
import { productSchema } from '../../../utils/schema';
import { PRIMARY_CHEAT_IMAGE } from '../../../config/siteImages';
import { Button } from '@/components/starwind/button';

const seo = ZADEYO_R6_PRODUCT_SEO;
const heroAlt = 'Escape from Tarkov PC gameplay — EFT Cheats checkout preview';
const headingFor = (key: (typeof seo.bodySections)[number]['headingKey']) => seo[key];
---

<CheckoutBridgeLayout
  title={seo.title}
  description={seo.description}
  logoAlt={seo.logoAlt}
  ogImage={PRIMARY_CHEAT_IMAGE}
  ogImageAlt="Escape from Tarkov PC competitive match — EFT Cheats checkout preview"
  jsonLd={[
    productSchema({
      name: seo.h1,
      description: seo.description,
      url: '/go/tarkov/',
      offerUrl: ZADEYO_TARKOV_CHECKOUT_URL,
    }),
  ]}
>
  <style slot="head" is:inline>
    @media (max-width: 639px) {
      :root {
        --checkout-rbp: phone;
      }
    }
    @media (min-width: 640px) and (max-width: 1023px) {
      :root {
        --checkout-rbp: tablet;
      }
    }
    @media (min-width: 1024px) {
      :root {
        --checkout-rbp: desktop;
      }
    }
  </style>
  <article>
    <header class="space-y-4 text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">EFT Cheats · PC multiplayer</p>
      <h1 class="text-3xl font-bold leading-tight md:text-4xl">{seo.h1}</h1>
      <p class="text-lg leading-relaxed text-muted-foreground">{seo.intro}</p>
      <Button as="a" href={ZADEYO_TARKOV_CHECKOUT_URL} variant="primary" size="lg" class="mt-2">
        Open secure checkout
      </Button>
    </header>

    <figure class="mt-8 overflow-hidden rounded-xl border border-border">
      <img
        src={PRIMARY_CHEAT_IMAGE}
        alt={heroAlt}
        width="920"
        height="518"
        loading="lazy"
        class="h-auto w-full object-cover"
      />
    </figure>

    <section class="mt-10 space-y-4" aria-labelledby="product-details-title">
      <h2 id="product-details-title" class="text-xl font-semibold">{seo.h2ProductDetails}</h2>
      <p class="text-muted-foreground">
        Compare modules on{' '}
        <a href="/products/tarkov/" class="text-primary hover:underline">cheatseft.org Escape from Tarkov product catalog</a>
        before you continue. Checkout and license delivery use secure payment with instant digital access.
      </p>
    </section>

    <section class="mt-8 space-y-4" aria-labelledby="features-title">
      <h2 id="features-title" class="text-xl font-semibold">{seo.h2Features}</h2>
      {seo.sections.map((section) => (
        <div class="space-y-2">
          <h3 class="text-lg font-semibold">{section.heading}</h3>
          {section.paragraphs.map((paragraph) => (
            <p class="text-muted-foreground">{paragraph}</p>
          ))}
        </div>
      ))}
      <ul class="list-disc space-y-2 pl-5 text-muted-foreground">
        <li>Configurable aimbot FOV, smoothness, and hitbox selection.</li>
        <li>Player ESP, skeleton types, snaplines, and loot and container ESP lists.</li>
        <li>Save and load config profiles for competitive and unPMC raid playlists.</li>
      </ul>
    </section>

    <section class="mt-8 space-y-3" aria-labelledby="system-requirements-title">
      <h2 id="system-requirements-title" class="text-xl font-semibold">{seo.h2SystemRequirements}</h2>
      <p class="text-muted-foreground">
        Windows 10 and 11 supported. HVCI ON, Core Isolation ON, TPM ON, Secure Boot ON. Cloud DMA is required for full functionality on supported builds.
      </p>
    </section>

    {
      seo.bodySections.map((block) => (
        <section class="mt-8 space-y-3" aria-labelledby={`go-tarkov-${block.id}`}>
          <h2 id={`go-tarkov-${block.id}`} class="text-xl font-semibold">
            {headingFor(block.headingKey)}
          </h2>
          {block.paragraphs.map((paragraph) => (
            <p class="text-muted-foreground">{paragraph}</p>
          ))}
        </section>
      ))
    }

    <section class="mt-8 space-y-3" aria-labelledby="checkout-help-title">
      <h2 id="checkout-help-title" class="text-lg font-semibold">Before you buy</h2>
      <p class="text-muted-foreground">
        Read the{' '}
        <a href="/faq/" class="text-primary hover:underline">FAQ on loader setup and anti-cheat checks</a>
        or open the{' '}
        <a href="/support/" class="text-primary hover:underline">support desk for checkout help</a>.
      </p>
    </section>
  </article>
</CheckoutBridgeLayout>
